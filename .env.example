# RecallDesk AI Environment Configuration Example

# Backend Express Configuration
PORT=5000

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Vectorize Hindsight Client Configuration
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=local-dev

# Local Vectorize Hindsight Engine Configuration (Self-Hosted)
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LLM_PROVIDER=gemini
HINDSIGHT_API_LLM_MODEL=gemini-3.5-flash-lite
HINDSIGHT_API_EMBEDDINGS_PROVIDER=google
HINDSIGHT_API_RERANKER_PROVIDER=rrf
HINDSIGHT_API_LLM_API_KEY=your_gemini_api_key_here
